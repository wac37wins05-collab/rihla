# ── Billing Engine — Variables d'environnement ──────────────────────
# Copier ce fichier en .env et remplir les valeurs

# PostgreSQL — même DB que le backend FastAPI OU une DB séparée
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://rihla:change_me@localhost:5432/rihla_billing

# Port du serveur NestJS (ne pas changer sauf conflit)
PORT=3100

# Environnement
NODE_ENV=development

# JWT Secret (doit correspondre au secret FastAPI pour partager les tokens)
# Si non configuré, le guard JWT n'est pas activé en dev
JWT_SECRET=your-secret-key-here
